# === Domain ===
DOMAIN=judigot.com
# Derived automatically if not set:
# WWW_DOMAIN=www.judigot.com
# OPENCODE_SUBDOMAIN=dev.judigot.com

# === TLS ===
# SSL_CERT=/etc/letsencrypt/live/${DOMAIN}/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/${DOMAIN}/privkey.pem

# === OpenCode ===
OPENCODE_PORT=4097
# Supported values: nginx, opencode, github
WORKSPACE_AUTH_PROVIDER=github

# Used only when WORKSPACE_AUTH_PROVIDER=nginx or opencode
WORKSPACE_AUTH_USERNAME=
WORKSPACE_AUTH_PASSWORD=

ANTHROPIC_API_KEY=

# === GitHub OAuth ===
# Create a GitHub OAuth App with callback:
# https://${OPENCODE_SUBDOMAIN}/oauth2/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed to access the dev workspace.
GITHUB_ALLOWED_USERS=judigot
# Generate a 32-byte base64url secret. Keep it outside Git.
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_PORT=4180
# Optional reproducible version pin. When empty, setup resolves the latest release.
OAUTH2_PROXY_VERSION=

# === Apps ===
# Format: slug:type:frontend_port[:backend_port[:options]]
# Types: frontend, fullstack, laravel
# Options: ws (websocket support)
# Added automatically by scripts/add-app.sh
#
# Examples:
#   my-app:frontend:5177
#   scaffolder:fullstack:3000:5000:ws
#   admin:laravel:8000
APPS=""

# Optional: set a default app on the root domain (judigot.com)
# Leave empty to show the dashboard on judigot.com
# DEFAULT_APP=scaffolder
DEFAULT_APP=

# === Dashboard ===
DASHBOARD_PORT=3200
DASHBOARD_API_PORT=3100

# === Paths ===
OPENCODE_BACKEND=127.0.0.1:4097
WORKSPACE_ROOT=/var/www/workspace
